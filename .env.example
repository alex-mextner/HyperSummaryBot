# Required
BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=HyperSummaryBot

# AI Primary — Claude (optional until this service has a credential)
CLAUDE_API_TOKEN=
# Optional backup credential, preferably with independent quota.
CLAUDE_API_TOKEN2=
CLAUDE_BASE_URL=https://api.anthropic.com/v1/
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# AI Fallback — z.ai (OpenAI-compatible coding endpoint)
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3
ZAI_FAST_MODEL=glm-5.3-flash

# AI Last Fallback — HuggingFace Router
HF_TOKEN=your_hf_token
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen3.8-2.4T-A95B:deepinfra
HF_FAST_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct:deepinfra

# Optional — Groq (for voice transcription)
GROQ_API_KEY=your_groq_key

# Infrastructure
DATABASE_PATH=./data/hyper-summary.db
NODE_ENV=development

# Notion Integration (optional)
NOTION_TOKEN=secret_xxx

# MTProto (optional — for importing history before bot joined)
# Get api_id and api_hash at https://my.telegram.org
MTPROTO_API_ID=
MTPROTO_API_HASH=

# Admin and Debug
BOT_ADMIN_ID=your_telegram_user_id
# Bot API chat IDs only, comma-separated. Production access is fail-closed when empty.
ALLOWED_CHAT_IDS=-1001234567890,-123456789
AI_DEBUG_LOGS=true

# Webhook (optional — alternative to polling)
# Must use a domain with valid SSL cert. Bare IP won't work with Let's Encrypt.
# Current deployment uses: https://hyper-summary-bot.mextner.com/webhook
WEBHOOK_URL=
WEBHOOK_SECRET=change-me-in-production

# Test API (protected HTTP endpoints for debugging)
TEST_API_PASSWORD=change-me-in-production
TEST_API_PORT=3003

# Shared by the bot and the stopped-process admin CLI
MTPROTO_SESSION_PATH=data/mtcute-session
