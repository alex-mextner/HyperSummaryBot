{
  "name": "hyper-summary-bot",
  "version": "0.1.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --compile --outfile=bot src/index.ts",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "fmt": "oxfmt src/",
    "fmt:check": "oxfmt src/ --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "prepare": "husky"
  },
  "dependencies": {
    "@gramio/session": "latest",
    "@gramio/storage-sqlite": "latest",
    "@mtcute/bun": "^0.29.7",
    "drizzle-kit": "latest",
    "drizzle-orm": "latest",
    "gramio": "latest",
    "openai": "latest",
    "pino": "^10.3.1",
    "telegramify-markdown": "latest"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.82.0",
    "@types/bun": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ]
  }
}
