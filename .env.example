# Required
BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=HyperSummaryBot

# AI Primary — z.ai (OpenAI-compatible coding endpoint)
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.1
ZAI_FAST_MODEL=glm-4.7-flash

# AI Fallback — HuggingFace Router
HF_TOKEN=your_hf_token
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen3-235B-A22B
HF_FAST_MODEL=meta-llama/Llama-3.3-70B-Instruct

# AI Fallback — Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash

# Optional — Groq (for voice transcription)
GROQ_API_KEY=your_groq_key

# Infrastructure
DATABASE_PATH=./data/hyper-summary.db
NODE_ENV=development

# Notion Integration (optional)
NOTION_TOKEN=secret_xxx

# MTProto (optional — for importing history before bot joined)
# Get api_id and api_hash at https://my.telegram.org
MTPROTO_API_ID=
MTPROTO_API_HASH=

# Admin and Debug
BOT_ADMIN_ID=your_telegram_user_id
AI_DEBUG_LOGS=true

# Webhook (optional — alternative to polling)
WEBHOOK_URL=
WEBHOOK_SECRET=change-me-in-production

# Test API (protected HTTP endpoints for debugging)
TEST_API_PASSWORD=change-me-in-production
TEST_API_PORT=3001
